NODE_ENV=development
PORT=4002
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Shared local stack (ecommerce-infrastructure: docker compose up -d):
DATABASE_URL=postgresql+psycopg://product_svc:product_local_pw@localhost:5432/product_db
# Standalone (this repo: docker compose up -d):
# DATABASE_URL=postgresql+psycopg://product_svc:product_local_pw@localhost:5442/product_db
# Integration tests create and drop this database:
TEST_DATABASE_URL=postgresql+psycopg://product_svc:product_local_pw@localhost:5432/product_test
DB_POOL_SIZE=5

# Tokens are issued by ecommerce-auth-service and verified with its public keys.
JWKS_URL=http://localhost:4001/.well-known/jwks.json
JWT_ISSUER=ecommerce-auth-service
JWT_AUDIENCE=ecommerce-api
JWT_SERVICE_AUDIENCE=ecommerce-product-service
